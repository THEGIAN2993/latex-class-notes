   CharacterVariant.code = \CCM@KV@Option{CharacterVariant}{#1} ,
   StylisticSet.code     = \CCM@KV@Option{StylisticSet}{#1}     ,
   Style.code            = \CCM@KV@Option{Style}{#1}            ,
  }
\CCM@tighttrue
\ProcessKeyOptions
%
\ifCCM@tight
  \thinmuskip=2mu
  \medmuskip=2.5mu plus 1mu minus 2.5mu
  \thickmuskip=3.5mu plus 2.5mu
\fi

% Text Serif fonts:
\ifCCM@notext
\else
